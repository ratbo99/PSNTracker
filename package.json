{
  "name": "psn-trophy-tracker",
  "version": "0.7.1",
  "description": "RatBo's - PSN Tracker",
  "main": "server.js",
  "scripts": {
    "start": "npx nodemon server.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "bin": "server.js",
  "pkg": {
    "assets": [
      "public/**/*",
      "views/**/*"
    ]
  },
  "env": {
    "NODE_OPTIONS": "--network-family-autoselection-attempt-timeout=500"
  },
  "keywords": [
    "twitch",
    "obs",
    "playstation",
    "trophies"
  ],
  "author": "David Fickert",
  "license": "MIT",
  "dependencies": {
    "express": "^4.17.1",
    "node-fetch": "^2.7.0",
    "socket.io": "^4.3.1"
  },
  "devDependencies": {
    "@eslint/css": "^0.4.0",
    "@eslint/js": "^9.21.0",
    "eslint": "^9.21.0",
    "globals": "^16.0.0",
    "pug": "^3.0.2"
  }
}
